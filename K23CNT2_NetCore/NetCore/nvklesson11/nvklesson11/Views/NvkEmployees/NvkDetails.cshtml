@model nvklesson11.Models.NvkEmployee

@{
    ViewData["Title"] = "Chi tiết nhân viên";
}

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h1>@ViewData["Title"]</h1>
            </div>
            <div class="card-body">
                <div class="form-group">
                    <label asp-for="NvkEmpName" class="control-label"></label>
                    <input asp-for="NvkEmpName" class="form-control" readonly />
                </div>
                <div class="form-group">
                    <label asp-for="NvkEmpLevel" class="control-label"></label>
                    <input asp-for="NvkEmpLevel" class="form-control" readonly />
                </div>
                <div class="form-group">
                    <label asp-for="NvkEmpStartDate" class="control-label"></label>
                    <input asp-for="NvkEmpStartDate" class="form-control" readonly />
                </div>
                <div class="form-group">
                    <label asp-for="NvkEmpStatus" class="control-label"></label>
                    <input asp-for="NvkEmpStatus" class="form-control" readonly />
                </div>
            </div>
            <div class="card-footer">
                <a asp-action="NvkEdit" asp-route-id="@Model.NvkEmpId" class="btn btn-primary">Sửa</a>
                <a asp-action="NvkIndex" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </div>
</div>

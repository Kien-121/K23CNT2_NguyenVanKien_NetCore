@model IEnumerable<nvklesson10.Models.Company>

@{
    ViewData["Title"] = "Danh muc loai";
}

<h1> @ViewData["Title"]</h1>

<p>
    <a asp-action="NvkCreate" class="btn btn-primary">Create New</a>
</p>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CateId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CateName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CateStatus)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.CateId)
                </td>
            <td>
                @Html.DisplayFor(modelItem => item.CateName)
            </td>
            <td>
					@if (item.CateStatus == null)
					{
						<text>Hiển thị </text>
					}
					else
					{
                        <text>Tạm khóa  </text>
					}
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.CateId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.CateId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.CateId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
